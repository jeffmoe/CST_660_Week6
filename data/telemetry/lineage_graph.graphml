    </edge>
    <edge source="raw.storm_events" target="stg.storm_events">
      <data key="d6">select/geo-filter</data>
    </edge>
    <edge source="stg.policy" target="int.claim_policy_enriched">
      <data key="d6">INNER JOIN ON claim.policy_id = policy.policy_id AND policy.policy_status IN ('IF','CX','EX')</data>
    </edge>
    <edge source="stg.claim" target="int.claim_policy_enriched">
      <data key="d6">base</data>
    </edge>
    <edge source="stg.claim_payment" target="int.claim_financials">
      <data key="d6">aggregate by claim_id</data>
    </edge>
    <edge source="stg.claim_status" target="mart.fct_claim_closed">
      <data key="d6">INNER JOIN latest status = 'CLOSED'</data>
    </edge>
    <edge source="stg.adjuster" target="mart.dim_adjuster">
      <data key="d6">base</data>
    </edge>
    <edge source="stg.storm_events" target="mart.agg_claim_severity_daily">
      <data key="d6">LEFT JOIN cat tagging</data>
    </edge>
    <edge source="int.claim_policy_enriched" target="mart.fct_claim_closed">
      <data key="d6">base</data>
    </edge>
    <edge source="int.claim_financials" target="mart.fct_claim_closed">
      <data key="d6">LEFT JOIN ON claim_id</data>
    </edge>
    <edge source="mart.fct_claim_closed" target="mart.agg_claim_severity_daily">
      <data key="d6">GROUP BY close_date, lob_cd</data>
    </edge>
    <edge source="mart.dim_adjuster" target="mart.agg_claim_severity_daily">
      <data key="d6">LEFT JOIN ON adjuster_id</data>
    </edge>
    <edge source="mart.agg_claim_severity_daily" target="bi.claims_severity_dashboard">
      <data key="d6">extract refresh</data>
    </edge>
    <data key="d0">brightline_claims_lineage</data>
